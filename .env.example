# CampusHub Environment Variables
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=db_url
JWT_SECRET=campushub-super-secret-jwt-key-2026-production
JWT_REFRESH_SECRET=campushub-super-secret-refresh-key-2026-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
COOKIE_SECRET=campushub-cookie-encryption-secret-string-at-least-32-chars

# Database credentials for MariaDB adapter
DB_HOST=localhost
DB_PORT=3306
DB_USER=campushub_user
DB_PASSWORD=password
DB_NAME=campushub
