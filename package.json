{
  "name": "campushub",
  "private": true,
  "version": "1.0.0",
  "description": "CampusHub — Full-Stack Campus Management Platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "test:api": "npm run test -w apps/api",
    "test": "npm run test:api",
    "typecheck:api": "npm run typecheck -w apps/api",
    "typecheck:web": "npm run typecheck -w apps/web",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api"
  },
  "keywords": [
    "campushub",
    "fastify",
    "prisma",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
